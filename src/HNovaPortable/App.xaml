<Application x:Class="HNovaPortable.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HNovaPortable.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="FontUi">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
            <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
            <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
            <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBoolean" />
            <converters:EnumToBooleanConverter x:Key="EnumToBoolean" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
