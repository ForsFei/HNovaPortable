<Window x:Class="HNovaPortable.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出与迁移"
        Width="760"
        Height="760"
        MinWidth="700"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontUi}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="导出与迁移" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="导出后的目录可直接复制到新电脑，双击 HNovaPortable.exe 继续使用。" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22,16,22,0">
            <StackPanel>
                <!-- 范围 -->
                <Border Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="导出范围" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Style="{StaticResource CheckBoxStyle}" Content="导出全部" IsChecked="{Binding ExportAll}" />
                                <TextBlock Text="{Binding SelectedCount, StringFormat='已选 {0} 个'}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ListBox ItemsSource="{Binding Apps}"
                                 MaxHeight="150"
                                 Margin="0,10,0,0"
                                 Background="{DynamicResource BrushBgSurfaceAlt}"
                                 BorderBrush="{DynamicResource BrushBorderSubtle}"
                                 BorderThickness="1"
                                 IsEnabled="{Binding ExportAll, Converter={StaticResource InverseBoolean}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="10,6">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource CheckBoxStyle}" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 格式 -->
                <Border Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="导出格式" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="fmt" Content="文件夹" IsChecked="{Binding FormatIndex, Converter={StaticResource EnumToBoolean}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="fmt" Content="ZIP" Margin="20,0,0,0" IsChecked="{Binding FormatIndex, Converter={StaticResource EnumToBoolean}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="fmt" Content="7z" Margin="20,0,0,0" IsChecked="{Binding FormatIndex, Converter={StaticResource EnumToBoolean}, ConverterParameter=2}" IsEnabled="{Binding HasSevenZip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TargetHint}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 选项 -->
                <Border Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="迁移选项" FontWeight="SemiBold" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}" Margin="0,12,0,0" Content="包含 HNova Portable 程序本体（导出后可直接运行）" IsChecked="{Binding IncludeProgramFiles}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" Content="把「引用模式」的软件复制进包，并转为托管模式" IsChecked="{Binding ConvertLinkedToManaged}" />
                        <CheckBox Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" Content="保留未打包的引用记录（新电脑上会提示重新定位）" IsChecked="{Binding IncludeLinkedRecords}" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="托管软件的路径在库内始终是相对路径（Apps/…），因此迁移后无需重新指定 EXE。" />
                    </StackPanel>
                </Border>

                <!-- 目标 -->
                <Border Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="导出位置" FontWeight="SemiBold" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="浏览…" Margin="8,0,0,0" Command="{Binding BrowseTargetCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="导出前会检查文件是否齐全、目标磁盘剩余空间是否足够，并在完成后核对文件数量与数据库完整性。" />
                    </StackPanel>
                </Border>

                <!-- 结果 -->
                <Border Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushAccent}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="结果" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Content="打开目标位置"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Command="{Binding OpenTargetCommand}"
                                IsEnabled="{Binding CanOpenTarget}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="22,14" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="关闭" Click="Close_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="取消" Margin="8,0,0,0" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="开始导出" Margin="8,0,0,0" MinWidth="104" Command="{Binding StartCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />
                </StackPanel>

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Maximum="100" Value="{Binding Progress}" Style="{StaticResource SlimProgressBarStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
