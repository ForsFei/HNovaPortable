<Window x:Class="HNovaPortable.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HNova Portable"
        Icon="/Assets/HNovaPortable.ico"
        Height="880"
        Width="1360"
        MinHeight="640"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBgBase}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontUi}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ViewToggleStyle" TargetType="Button" BasedOn="{StaticResource SubtleIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Library.IsGridView}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListToggleStyle" TargetType="Button" BasedOn="{StaticResource SubtleIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Library.IsGridView}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="12">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushBgSelected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource BrushBgBase}"
            BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ==================== 标题栏 ==================== -->
            <Grid Grid.Row="0" Background="{DynamicResource BrushBgSurface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/HNovaPortable.ico" Width="20" Height="20" />
                    <TextBlock Text="HNova Portable"
                               Margin="9,0,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BrushAccentSubtle}"
                            CornerRadius="4"
                            Padding="6,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="便携版"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushAccent}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="最小化"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE922;"
                            ToolTip="最大化"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Maximize_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="关闭"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ==================== 主体 ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边导航 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,8,0,8">
                            <ItemsControl ItemsSource="{Binding NavSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionLabel}" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource NavButtonStyle}"
                                                                Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Glyph}"
                                                                           FontFamily="{DynamicResource FontIcon}"
                                                                           FontSize="14"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           Margin="10,0,6,0"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border Grid.Column="2"
                                                                        MinWidth="20"
                                                                        Padding="5,0"
                                                                        CornerRadius="6"
                                                                        VerticalAlignment="Center"
                                                                        Background="{DynamicResource BrushBgSurfaceAlt}"
                                                                        Visibility="{Binding Count, Converter={StaticResource ZeroToCollapsed}}">
                                                                    <TextBlock Text="{Binding Count}"
                                                                               FontSize="10.5"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{DynamicResource BrushTextTertiary}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="0,1,0,0"
                                Padding="8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Style="{StaticResource FlatButtonStyle}"
                                        Command="{Binding CycleThemeCommand}"
                                        ToolTip="切换主题：跟随系统 / 深色 / 浅色">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ThemeGlyph}"
                                                   FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ThemeLabel}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        Content="&#xE8B7;"
                                        ToolTip="打开库根目录"
                                        Command="{Binding OpenLibraryRootCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 主内容区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 页头 -->
                    <Grid Margin="28,20,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle}" />
                            <TextBlock Text="{Binding Library.FilterSummary}" Style="{StaticResource Text.Subtitle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox"
                                     Width="240"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Tag="搜索名称 / 标签 / 功能描述"
                                     Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Margin="8,0,0,0"
                                    Background="{DynamicResource BrushBgSurfaceAlt}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ViewToggleStyle}"
                                            Content="&#xF0E2;"
                                            ToolTip="卡片视图"
                                            Command="{Binding Library.SetViewModeCommand}"
                                            CommandParameter="grid" />
                                    <Button Style="{StaticResource ListToggleStyle}"
                                            Content="&#xEA37;"
                                            ToolTip="列表视图"
                                            Command="{Binding Library.SetViewModeCommand}"
                                            CommandParameter="list" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="&#xE72C;"
                                    ToolTip="刷新"
                                    Command="{Binding RefreshCommand}" />

                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="{Binding Library.DetailsButtonText}"
                                    Command="{Binding Library.ToggleDetailsCommand}" />
                            <Button x:Name="MoreButton"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    Margin="4,0,0,0"
                                    Content="&#xE712;"
                                    ToolTip="更多操作"
                                    Click="More_Click">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="开机自启动管理…" Command="{Binding Library.ManageStartupCommand}" />
                                        <MenuItem Header="检查全库更新" Command="{Binding Library.CheckAllUpdatesCommand}" />
                                        <MenuItem Header="重新扫描软件库" Command="{Binding Library.RescanCommand}" />
                                        <MenuItem Header="导出与迁移…" Command="{Binding Library.ExportCommand}" />
                                        <MenuItem Header="导入库包…" Command="{Binding Library.ImportPackageCommand}" />
                                        <Separator />
                                        <MenuItem Header="备份软件库" Command="{Binding Library.BackupCommand}" />
                                        <MenuItem Header="从备份恢复…" Command="{Binding Library.RestoreBackupCommand}" />
                                        <Separator />
                                        <MenuItem Header="打开 Apps 目录" Command="{Binding OpenAppsFolderCommand}" />
                                        <MenuItem Header="打开 Data 目录" Command="{Binding OpenDataFolderCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Margin="10,0,0,0"
                                    Content="导入软件"
                                    Command="{Binding Library.ImportCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 内容 -->
                    <Grid Grid.Row="1" Margin="28,16,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource BrushBgSurface}"
                                BorderBrush="{DynamicResource BrushWarning}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,12"
                                Visibility="{Binding LocationWarning, Converter={StaticResource NotEmptyToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{DynamicResource FontIcon}"
                                           FontSize="14"
                                           Foreground="{DynamicResource BrushWarning}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LocationWarning}"
                                           Style="{StaticResource Text.Body}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <DockPanel Grid.Row="1" Margin="0,0,0,16">
                            <!-- 详情面板 -->
                            <Border DockPanel.Dock="Right"
                                    Width="304"
                                    Margin="16,0,0,0"
                                    Background="{DynamicResource BrushBgSurface}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding Library.IsDetailsVisible, Converter={StaticResource BooleanToVisibility}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="18" DataContext="{Binding Library.SelectedApp}">
                                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource BrushBgSurfaceAlt}" HorizontalAlignment="Left">
                                            <Grid>
                                                <TextBlock Text="&#xE7B8;"
                                                           FontFamily="{DynamicResource FontIcon}"
                                                           FontSize="24"
                                                           Foreground="{DynamicResource BrushTextTertiary}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="44" Height="44" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,14,0,0"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding PathText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text="{Binding HealthText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding LaunchCountText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="0,4,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    Content="启动"
                                                    MinWidth="76"
                                                    Command="{Binding DataContext.Library.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="打开目录"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.Library.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="编辑"
                                                    MinWidth="76"
                                                    Command="{Binding DataContext.Library.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="{Binding FavoriteButtonText}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.Library.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Content="删除"
                                                Command="{Binding DataContext.Library.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <TextBlock Text="{Binding TagsText}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="0,14,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock Text="{Binding Description}" Margin="0,14,0,0"
                                                   Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                                   Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}" />

                                        <Border Margin="0,14,0,0"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="{DynamicResource BrushBgSurfaceAlt}"
                                                Visibility="{Binding HasPortabilityHint, Converter={StaticResource BooleanToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="迁移提示" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}" />
                                                <TextBlock Text="{Binding PortabilityHint}"
                                                           Style="{StaticResource Text.Caption}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- 列表 / 空状态 -->
                            <Grid>
                                <!-- 卡片视图 -->
                                <ListBox x:Name="CardList"
                                         Style="{StaticResource AppListBoxStyle}"
                                         ItemsSource="{Binding Library.Apps}"
                                         SelectedItem="{Binding Library.SelectedApp}"
                                         MouseDoubleClick="OnAppListDoubleClick"
                                         Visibility="{Binding Library.IsGridView, Converter={StaticResource BooleanToVisibility}}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="启动" Command="{Binding Library.LaunchCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <MenuItem Header="打开所在目录" Command="{Binding Library.OpenFolderCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <Separator />
                                            <MenuItem Header="{Binding Library.SelectedApp.FavoriteButtonText}" Command="{Binding Library.ToggleFavoriteCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <MenuItem Header="编辑信息…" Command="{Binding Library.EditCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <MenuItem Header="重新定位主程序…" Command="{Binding Library.RelocateCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <Separator />
                                            <MenuItem Header="从库中移除" Command="{Binding Library.DeleteCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="190"
                                                    Height="152"
                                                    Margin="0,0,10,10"
                                                    Padding="14"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource BrushBgSurface}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1"
                                                    ToolTip="{Binding PathText}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource BrushBgSurfaceAlt}" HorizontalAlignment="Left">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initial}"
                                                                           FontSize="16"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrushTextTertiary}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <Image Source="{Binding Icon}" Width="32" Height="32" />
                                                            </Grid>
                                                        </Border>

                                                        <Button Width="26"
                                                                Height="26"
                                                                FontSize="12"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Content="&#xE734;"
                                                                ToolTip="收藏"
                                                                Foreground="{DynamicResource BrushTextTertiary}"
                                                                Command="{Binding DataContext.Library.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SubtleIconButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="36"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CategoryText}"
                                                                   Style="{StaticResource Text.Caption}"
                                                                   Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Grid Grid.Row="2">
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ModeText}"
                                                                   Style="{StaticResource Text.Caption}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 列表视图 -->
                                <ListBox x:Name="RowList"
                                         Style="{StaticResource AppListBoxStyle}"
                                         ItemsSource="{Binding Library.Apps}"
                                         SelectedItem="{Binding Library.SelectedApp}"
                                         MouseDoubleClick="OnAppListDoubleClick"
                                         Visibility="{Binding Library.IsGridView, Converter={StaticResource InverseBooleanToVisibility}}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="启动" Command="{Binding Library.LaunchCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <MenuItem Header="打开所在目录" Command="{Binding Library.OpenFolderCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <Separator />
                                            <MenuItem Header="{Binding Library.SelectedApp.FavoriteButtonText}" Command="{Binding Library.ToggleFavoriteCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <MenuItem Header="编辑信息…" Command="{Binding Library.EditCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <MenuItem Header="重新定位主程序…" Command="{Binding Library.RelocateCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                            <Separator />
                                            <MenuItem Header="从库中移除" Command="{Binding Library.DeleteCommand}" CommandParameter="{Binding Library.SelectedApp}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="12,8"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource BrushBgSurface}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrushBgSurfaceAlt}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image Source="{Binding Icon}" Width="24" Height="24" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Description}"
                                                                   Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CategoryText}"
                                                               Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,16,0" />

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding SizeText}"
                                                               Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="70"
                                                               TextAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 空状态 -->
                                <Border Background="{DynamicResource BrushBgSurface}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Visibility="{Binding Library.HasApps, Converter={StaticResource InverseBooleanToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24">
                                        <Border Width="66" Height="66" CornerRadius="18" HorizontalAlignment="Center" Background="{DynamicResource BrushAccentSubtle}">
                                            <TextBlock Text="&#xE8F1;"
                                                       FontFamily="{DynamicResource FontIcon}"
                                                       FontSize="28"
                                                       Foreground="{DynamicResource BrushAccent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Text="{Binding Library.EmptyTitle}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,18,0,0" />

                                        <TextBlock Style="{StaticResource Text.Body}"
                                                   Text="{Binding Library.EmptyDescription}"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,0" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    Content="导入软件"
                                                    Command="{Binding Library.ImportCommand}" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="打开 Apps 目录"
                                                    Margin="10,0,0,0"
                                                    Command="{Binding OpenAppsFolderCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ==================== 状态栏 ==================== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushBgSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="{DynamicResource FontIcon}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                        <TextBlock Text="{Binding LibraryRoot}"
                                   ToolTip="{Binding LibraryRoot}"
                                   MaxWidth="620"
                                   Margin="7,0,0,0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Library.StatusMessage}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="·" Margin="8,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextTertiary}" />
                        <TextBlock Text="{Binding LibraryMeta}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                        <TextBlock Text="·" Margin="8,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextTertiary}" />
                        <TextBlock Text="{Binding VersionText}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
