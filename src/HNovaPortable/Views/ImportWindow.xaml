<Window x:Class="HNovaPortable.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入软件"
        Width="1020"
        Height="720"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontUi}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="导入软件" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding ScanSummary, FallbackValue='识别主程序 → 确认信息 → 复制进库'}"
                               Style="{StaticResource Text.Subtitle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding AddFilesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" Content="添加 EXE" />
                    <Button Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0" Command="{Binding ScanFolderCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" Content="扫描文件夹" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="22,16,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="352" />
            </Grid.ColumnDefinitions>

            <!-- 候选列表 -->
            <Grid Grid.Column="0">
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushBgSelected}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BrushBgSurface}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0" />

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding ExeCountText}" Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource BrushAccentSubtle}"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ModeBadge}" FontSize="10.5" Foreground="{DynamicResource BrushAccent}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <Border Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                        <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource BrushAccentSubtle}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B5;"
                                       FontFamily="{DynamicResource FontIcon}"
                                       FontSize="24"
                                       Foreground="{DynamicResource BrushAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="先选择软件来源" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Text.Body}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"
                                   Text="扫描一个装满免安装软件的文件夹：每个子文件夹会被识别为一个软件，并自动挑出最可能是主程序的 EXE。" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding AddFilesCommand}" Content="添加 EXE" />
                            <Button Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0" Command="{Binding ScanFolderCommand}" Content="扫描文件夹" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 详情 -->
            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Background="{DynamicResource BrushBgSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="导入设置" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="在左侧勾选要导入的软件，右侧设置会应用到当前选中项。"
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <ContentControl Content="{Binding SelectedItem}" Margin="0,14,0,0">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolean}}">
                                        <TextBlock Text="软件名称" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,6,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Text="分类" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                                        <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                                  Margin="0,6,0,0"
                                                  ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding Category}" />

                                        <TextBlock Text="导入模式" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                                        <StackPanel Margin="0,8,0,0">
                                            <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="mode" Content="托管：复制进库" IsChecked="{Binding IsManaged}" />
                                            <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="mode" Content="引用：保留原位置" IsChecked="{Binding IsLinked}" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                        <TextBlock Text="主程序" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                                        <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                                  Margin="0,6,0,0"
                                                  ItemsSource="{Binding Candidates}"
                                                  SelectedItem="{Binding MainExecutable}"
                                                  IsEnabled="{Binding CanChooseMain}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayWithPath}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding MainExecutableText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                                  Margin="0,10,0,0"
                                                  Content="连同所在目录一起复制"
                                                  IsChecked="{Binding CopyWholeFolder}"
                                                  Visibility="{Binding IsSingleExe, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock Text="启动参数" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,6,0,0" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,10" />

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;"
                                                       FontFamily="{DynamicResource FontIcon}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource BrushWarning}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,6,0" />
                                            <TextBlock Text="{Binding FlagsText}"
                                                       Style="{StaticResource Text.Caption}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="268" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <TextBlock Text="没有选中任何条目"
                                   Margin="0,20,0,0"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushBgSurface}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="22,14"
                Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="关闭" Click="Close_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="取消" Margin="8,0,0,0" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="112" Command="{Binding ImportSelectedCommand}" IsEnabled="{Binding CanImport}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="开始导入" />
                            <TextBlock Text="{Binding SelectedSummary}" Margin="8,0,0,0" Opacity="0.75" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                             Margin="0,12,0,0"
                             Maximum="100"
                             Value="{Binding Progress}"
                             Style="{StaticResource SlimProgressBarStyle}" />
            </Grid>
        </Border>

        <!-- 结果遮罩 -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushBgBase}"
                Opacity="0.98"
                Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibility}}">
            <Border Background="{DynamicResource BrushBgSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="26"
                    MaxWidth="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="导入结果" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultText}"
                               Style="{StaticResource Text.Body}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="继续导入" Command="{Binding ResetCommand}" />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="完成" Margin="10,0,0,0" Click="Close_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
