<Window x:Class="HNovaPortable.Views.EditAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑软件"
        Width="540"
        Height="680"
        MinWidth="480"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontUi}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource BrushBgSurfaceAlt}">
                <Grid>
                    <TextBlock Text="&#xE7B8;"
                               FontFamily="{DynamicResource FontIcon}"
                               FontSize="20"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image Source="{Binding Icon}" Width="36" Height="36" />
                </Grid>
            </Border>

            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PathText}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,4,0,0"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="名称" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,6,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="分类" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,6,0,0"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding Category}" />

                <TextBlock Text="标签（用逗号或空格分隔）" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,6,0,0" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="启动参数" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,6,0,0"
                         Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                         Tag="例如 -portable --no-sandbox" />

                <TextBlock Text="工作目录" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                <TextBox Style="{StaticResource InputTextBoxStyle}" Margin="0,6,0,0" Text="{Binding WorkDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding WorkDirectoryHint}" Style="{StaticResource Text.Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />

                <TextBlock Text="备注" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,0" />
                <TextBox Style="{StaticResource InputTextAreaStyle}" Margin="0,6,0,0" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Style="{StaticResource CheckBoxStyle}"
                          Margin="0,16,0,0"
                          Content="收藏这个软件"
                          IsChecked="{Binding IsFavorite}" />

                <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="存储方式" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ModeText}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="版本 / 大小" Style="{StaticResource Text.Caption}" />
                        <TextBlock FontSize="12.5" Margin="0,3,0,0">
                            <Run Text="{Binding VersionText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding HealthText}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButtonStyle}" Content="取消" Command="{Binding CancelCommand}" MinWidth="88" />
            <Button Style="{StaticResource AccentButtonStyle}" Content="保存" Command="{Binding SaveCommand}" Margin="10,0,0,0" MinWidth="88" />
        </StackPanel>
    </Grid>
</Window>
