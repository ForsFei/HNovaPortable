<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorBgBase">#F2F4F8</Color>
    <Color x:Key="ColorBgSurface">#FFFFFF</Color>
    <Color x:Key="ColorBgSurfaceAlt">#F7F9FC</Color>
    <Color x:Key="ColorBgElevated">#FFFFFF</Color>
    <Color x:Key="ColorBgHover">#EDF1F7</Color>
    <Color x:Key="ColorBgSelected">#E3ECFD</Color>

    <Color x:Key="ColorBorderSubtle">#E8ECF2</Color>
    <Color x:Key="ColorBorderDefault">#D9DFE9</Color>
    <Color x:Key="ColorBorderStrong">#C3CBD9</Color>

    <Color x:Key="ColorTextPrimary">#10131A</Color>
    <Color x:Key="ColorTextSecondary">#4B5566</Color>
    <Color x:Key="ColorTextTertiary">#8A93A5</Color>

    <Color x:Key="ColorAccent">#2563EB</Color>
    <Color x:Key="ColorAccentHover">#1D4ED8</Color>
    <Color x:Key="ColorAccentSubtle">#E4EDFE</Color>

    <Color x:Key="ColorDanger">#DC2626</Color>
    <Color x:Key="ColorSuccess">#16A34A</Color>
    <Color x:Key="ColorWarning">#D97706</Color>

    <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource ColorBgBase}" />
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}" />
    <SolidColorBrush x:Key="BrushBgSurfaceAlt" Color="{StaticResource ColorBgSurfaceAlt}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />
    <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource ColorBgHover}" />
    <SolidColorBrush x:Key="BrushBgSelected" Color="{StaticResource ColorBgSelected}" />

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBorderDefault}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentSubtle" Color="{StaticResource ColorAccentSubtle}" />

    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />

    <SolidColorBrush x:Key="BrushCaptionCloseHover" Color="#C42B1C" />
    <SolidColorBrush x:Key="BrushOverlay" Color="#66000000" />

    <LinearGradientBrush x:Key="BrushBrandMark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#1D4ED8" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
